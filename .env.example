# Optional non-secret runtime choices. This file contains no credentials.
# Keep personal values in .env (ignored by Git).
# Load only when needed: uv run --env-file .env --locked qos model ...
QOS_AI_TEACHER=Qwen/Qwen3.5-0.8B
QOS_AI_DIR=qos_ai
# QOS_AI_DIR is relative to the compatibility workspace; qos_ai resolves to
# artifacts/qos_ai. An absolute path can select an isolated experiment.
# The existing RunPod credential file is .secrets/runpod_api_key and is not
# loaded automatically by the launcher.
